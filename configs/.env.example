CONFIG_PATH=./configs/.env

# Сервер
SERVER_PORT=8080
CONTEXT_TIMEOUT=30s

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
JWT_EXPIRY=24h

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=task_user
MYSQL_PASSWORD=task_pass
MYSQL_DB=task_db
MYSQL_SSLMODE=false
MYSQL_ROOT_PASSWORD=rootpass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Логгер
LOGGER_DEVELOPMENT=true
LOGGER_DISABLE_CALLER=false
LOGGER_DISABLE_STACKTRACE=false
LOGGER_ENCODING=console
LOGGER_LEVEL=info